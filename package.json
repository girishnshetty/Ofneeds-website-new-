{
  "name": "ofneeds-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test tests/lead-validation.test.mjs tests/quote-workflow.test.mjs tests/media-manifest.test.mjs tests/procurement.test.mjs tests/gift-cards.test.mjs tests/gift-card-brands.test.mjs",
    "test:smoke": "node tests/site-smoke.mjs",
    "test:seo": "node tests/seo-audit.mjs",
    "test:integration": "node tests/lead-integration.mjs",
    "audit:catalogues": "node scripts/audit-catalogues.mjs"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "amplify-adapter": "^1.3.0"
  }
}
